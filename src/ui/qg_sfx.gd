## Sound effects. Registered as the `Sfx` autoload.
##
## Assets are generated by `tools/make_sfx.py` (synthesised from scratch, no
## third-party samples), so there is nothing to license. Missing files are
## ignored: the game must stay playable even if someone strips the audio assets.
extends Node

const CLIP_PATHS := {
	"stone_black": "res://assets/audio/stone_black.wav",
	"stone_white": "res://assets/audio/stone_white.wav",
	"split": "res://assets/audio/split.wav",
	"collapse": "res://assets/audio/collapse.wav",
	"pass": "res://assets/audio/pass.wav",
	"click": "res://assets/audio/click.wav",
	"mark": "res://assets/audio/mark.wav",
	"confirm": "res://assets/audio/confirm.wav",
	"win": "res://assets/audio/win.wav",
	"lose": "res://assets/audio/lose.wav",
}

const VOICES := 8

## Seamless 48 s ambient loop, generated by `tools/make_music.py`. The .import
## file sets loop_mode=1 so the stream loops on its own.
const MUSIC_PATH := "res://assets/audio/bgm_quantum.wav"
const MUSIC_VOLUME_DB := -11.0

var _clips: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _music: AudioStreamPlayer = null
var _music_wanted: bool = true


func _ready() -> void:
	for key in CLIP_PATHS.keys():
		var path: String = CLIP_PATHS[key]
		if ResourceLoader.exists(path):
			_clips[key] = load(path)
	for index in range(VOICES):
		var player := AudioStreamPlayer.new()
		player.name = "Voice%d" % index
		player.bus = "Master"
		add_child(player)
		_players.append(player)

	_music = AudioStreamPlayer.new()
	_music.name = "Music"
	_music.bus = "Master"
	add_child(_music)
	if ResourceLoader.exists(MUSIC_PATH):
		_music.stream = load(MUSIC_PATH)
	# Deferred so the autoload finishes initialising before the stream starts.
	call_deferred("_apply_music_state")


# --------------------------------------------------------------------------
# Music
# --------------------------------------------------------------------------

func is_music_available() -> bool:
	return _music != null and _music.stream != null


func play_music() -> void:
	_music_wanted = true
	_apply_music_state()


func stop_music() -> void:
	_music_wanted = false
	_apply_music_state()


func _apply_music_state() -> void:
	if _music == null or _music.stream == null:
		return
	var settings := get_node_or_null("/root/Settings")
	var enabled := _music_wanted
	var music_gain := 1.0
	if settings != null:
		enabled = enabled and bool(settings.get("music_enabled"))
		music_gain = float(settings.get("music_volume"))
	var master := float(settings.get("master_volume")) if settings != null else 1.0
	if not enabled or master <= 0.001 or music_gain <= 0.001:
		_music.stop()
		return
	_music.volume_db = MUSIC_VOLUME_DB + linear_to_db(clampf(music_gain * master, 0.0001, 1.0))
	if not _music.playing:
		_music.play()


## Called by the settings screen when the audio knobs change.
func refresh_audio_settings() -> void:
	_apply_music_state()


func has_clip(key: String) -> bool:
	return _clips.has(key)


## Plays a clip by name. Unknown names are a no-op so a UI call never crashes a
## match over a missing asset.
func play(key: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if not _clips.has(key) or _players.is_empty():
		return
	var player := _players[_next_voice]
	_next_voice = (_next_voice + 1) % _players.size()
	player.stream = _clips[key]
	player.volume_db = volume_db + _master_offset()
	player.pitch_scale = clampf(pitch, 0.5, 2.0)
	player.play()


## Convenience wrappers so call sites read like the action they describe.
##
## Stone placements get a little pitch and volume jitter: the same sample fired
## twenty times in a row otherwise sounds like a machine gun.
func play_stone(colour: int) -> void:
	var key := "stone_black" if colour == QGTypes.BLACK else "stone_white"
	play(key, randf_range(-4.5, -2.0), randf_range(0.96, 1.05))


func play_split() -> void:
	play("split", -2.0, randf_range(0.98, 1.02))


func play_collapse() -> void:
	play("collapse", -1.0, randf_range(0.97, 1.03))


func play_pass() -> void:
	play("pass", -6.0)


func play_click() -> void:
	play("click", -8.0)


## Scoring phase: toggling a dead-stone mark and signing off on the result.
func play_mark() -> void:
	play("mark", -5.0)


func play_confirm() -> void:
	play("confirm", -3.0)


func play_result(local_won: bool) -> void:
	play("win" if local_won else "lose", -2.0)


func _master_offset() -> float:
	var settings := get_node_or_null("/root/Settings")
	if settings == null:
		return 0.0
	var volume := float(settings.get("master_volume"))
	if volume <= 0.001:
		return -80.0
	return linear_to_db(clampf(volume, 0.0, 1.0))
